      "parameters": {
        "jsCode": "// Les 7 mots-clés de recherche (identiques au notebook)\nconst motsCles = [\n  \"data,analyst\", \"analyste,données\", \"analyste,BI\", \"business,intelligence\",\n  \"data,engineer\", \"ingénieur,data\",\n  \"data,scientist\",\n];\n\n// Un item par mot-clé : n8n appellera l'API une fois pour chacun\nreturn motsCles.map(mot => ({ json: { motsCles: mot } }));"
