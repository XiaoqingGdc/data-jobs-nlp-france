    {
      "parameters": {
        "jsCode": "// Règles d'étiquetage du métier (identiques au notebook, partie 2.2)\nconst REGLES = {\n  \"Data Analyst\": /data\\s*-?\\s*analy(?!tics)|analyste\\s+(de\\s+)?(donn[ée]es|data|bi\\b)|analyste\\s+d[ée]cisionnel|\\bbi\\s+analyst|business\\s+intelligence\\s+analyst/,\n  \"Data Engineer\": /data\\s*-?\\s*engineer|analytics\\s+engineer|ing[ée]nieure?\\s+(de\\s+)?(donn[ée]es|data|big\\s*data)(?!\\s*-?\\s*(analy|scien))/,\n  \"Data Scientist\": /data\\s*-?\\s*scien|scientifique\\s+des\\s+donn[ée]es|machine\\s+learning\\s+engineer|ml\\s+engineer/,\n};\n\nfunction etiqueter(intitule) {\n  const texte = (intitule || \"\").toLowerCase();\n  const trouves = Object.keys(REGLES).filter(m => REGLES[m].test(texte));\n  if (trouves.length === 1) return trouves[0];\n  return trouves.length ? \"Mixte\" : \"Autre\";\n}\n\n// Département : \"44 - NANTES\" -> \"44\", sinon les 2 premiers chiffres du code postal\nfunction extraireDepartement(lieu) {\n  const m = (lieu.libelle || \"\").match(/^\\s*(\\d{2,3}|2[AB])\\s*-/);\n  if (m) return m[1];\n  const cp = String(lieu.codePostal || \"\");\n  return /^\\d{2}/.test(cp) ? cp.slice(0, 2) : null;\n}\n\n// Une ligne par offre, avec les mêmes colonnes que la table \"offres\"\nreturn $input.all().map(item => {\n  const o = item.json;\n  const lieu = o.lieuTravail || {};\n  return {\n    json: {\n      id: o.id,\n      intitule: o.intitule,\n      description: o.description,\n      metier: etiqueter(o.intitule),\n      date_creation: o.dateCreation,\n      date_actualisation: o.dateActualisation || null,\n      departement: extraireDepartement(lieu),\n      lieu_libelle: lieu.libelle || null,\n      type_contrat: o.typeContrat || null,\n      experience_exige: o.experienceExige || null,\n      salaire_libelle: (o.salaire || {}).libelle || null,\n      entreprise_nom: (o.entreprise || {}).nom || null,\n      raw: o,          // JSON complet, pour pouvoir re-parser plus tard\n      last_seen: new Date().toISOString().slice(0, 10),   // date du jour (AAAA-MM-JJ)\n    },\n  };\n});"
      },
